# Copy to .env:  cp .env.example .env
# Only the three LLM_* variables below are required. Everything else has a default.

# --- Model endpoint (any OpenAI-compatible Chat Completions API) ---
# Ollama, `docker compose up` (app in Docker, Ollama on the host):
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Ollama, `make dev` (the app runs on your machine; on Windows, in WSL2 with mirrored networking):
# LLM_BASE_URL=http://localhost:11434/v1

# Ollama ignores the key, but the field must not be empty.
LLM_API_KEY=ollama

LLM_MODEL=qwen3.5:9b

# --- Optional: Groq (hosted, free tier; tested on 2026-11-21 with qwen/qwen3.8-27b) ---
# Each reviewer uses their own free key from https://console.groq.com/keys. Never commit it.
# The free tier limits tokens per minute: feedback requested right after the last question
# can come back degraded; requested a minute later, it worked in the test. See the README.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<your-groq-key>
# LLM_MODEL=qwen/qwen3.8-27b

# --- Optional: one model per role (each falls back to LLM_MODEL) ---
# The gate decides which hidden facts each student message earns, the client plays the bank
# customer, and the coach writes the feedback. Without these lines every role uses
# LLM_MODEL: one model, no swapping.
#
# Default routing (recommended on a 16 GB GPU): qwen3.5:9b for every role, so one model stays
# loaded and Ollama never swaps. In a paired test of the gate (PR #4), the 9b judged 81 of 81
# turns right and the 4b 74, for about 0.36 s more per turn. The evaluation (docs/evaluation.md)
# recommends it too: no attack out of 25 got a hidden fact out, 27 of the gate's 29 unlocks were
# correct, and the coach answered every time (median 10 s, p95 14 s). qwen3.5:4b for every role
# is about a third faster per call, but its gate let one attack through and made 9 false
# unlocks, and its client often answered in the wrong language.
# LLM_MODEL_GATE=qwen3.5:9b
# LLM_MODEL_CLIENT=qwen3.5:9b
# LLM_MODEL_COACH=qwen3.5:9b
#
# Optional, experimental "strong coach" (with swap): a bigger coach for richer feedback. It
# doesn't fit in GPU memory next to qwen3.5:9b, so Ollama swaps models when feedback is
# requested. That makes feedback slower, and Ollama's reload sometimes fails with HTTP 500,
# so allow more retries. On a 16 GB GPU it degraded 11 of 15 reports in the evaluation: each
# time, its hidden reasoning ran past the coach's token budget (1,500 tokens, then 3,000 on
# the retry), and Ollama's reload also crashed on some swaps. A report took about a minute. It
# needs a larger coach token budget, which is fixed in code for now, and more GPU memory, so
# that nothing swaps. In Docker, try it by setting these two lines (in place of the coach
# line above):
# LLM_MODEL_COACH=gpt-oss:20b
# LLM_MAX_RETRIES=4
# With `make dev`, leave .env as it is: run `make dev COACH=gpt-oss:20b` (or
# `make dev-strong-coach`) instead.
#
# Smoke-test either setup from backend/:
#   default:       uv run python -m app.llm.smoke
#   strong coach:  LLM_MODEL_COACH=gpt-oss:20b LLM_MAX_RETRIES=4 uv run python -m app.llm.smoke

# --- Optional: timeout per role, in seconds ---
# The coach waits longest because Ollama may first have to swap models in memory.
# LLM_TIMEOUT_GATE_S=30
# LLM_TIMEOUT_CLIENT_S=90
# LLM_TIMEOUT_COACH_S=240

# --- Optional: request handling ---
# How many model requests may run at once (1 suits a single local GPU).
# LLM_MAX_CONCURRENCY=1
# Retries after a timeout, connection error, 429 or 5xx, with exponential back-off.
# Use 4 with the strong coach (see above).
# LLM_MAX_RETRIES=2
# Ask the model not to "think" (sends reasoning_effort="none"). If the server rejects the
# parameter, it is dropped automatically. Any thinking text is always stripped from replies.
# LLM_DISABLE_THINKING=true

# --- Optional: cost estimates in data/events.jsonl (USD per million tokens) ---
# Leave unset for local models.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# --- Optional: logging ---
# Write student and client message text to the logs. Keep false to protect privacy.
# LOG_TRANSCRIPTS=false

# --- Optional: interview sessions (kept in memory; restarting the app clears them) ---
# Minutes without activity before a session is removed.
# SESSION_TTL_MINUTES=120
# Sessions kept at once; when full, the least recently used one is removed.
# MAX_SESSIONS=200
# Messages a student may send in one interview.
# MAX_STUDENT_TURNS=30
# Longest student message, in characters.
# MAX_MESSAGE_CHARS=1000
# How many recent messages the AI client sees.
# CLIENT_HISTORY_TURNS=12
# Most hidden facts one student message can unlock. The client's reaction to a product
# pitch doesn't count toward this.
# MAX_UNLOCKS_PER_TURN=2
# Seconds the API waits between two messages in one session; a faster one gets
# SESSION_RATE_LIMIT (HTTP 429). 0 turns the check off.
# MIN_MESSAGE_INTERVAL_S=1

# --- Ollama context length (an Ollama server setting, not read by this app) ---
# Ollama's default context is 4096 tokens, and it silently cuts longer prompts from the
# START, so the system prompt is lost first. Set OLLAMA_CONTEXT_LENGTH=16384 for the Ollama
# server (Windows: `setx OLLAMA_CONTEXT_LENGTH 16384`, then quit and restart Ollama).
# Check it with:  cd backend && uv run python -m app.llm.smoke --role coach

# --- App (optional) ---
# Paths default to <repo>/frontend/dist, <repo>/content and <repo>/data; the Docker image
# sets them to /app/... itself. Use absolute paths if you override them.
# FRONTEND_DIST=
# CONTENT_DIR=
# DATA_DIR=
